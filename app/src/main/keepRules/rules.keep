# Project specific R8 / ProGuard rules

# Keep Lifecycle observers and EmojiCompat initializer classes from being obfuscated or merged
-keep class * implements androidx.lifecycle.LifecycleObserver { *; }
-keep class * implements androidx.lifecycle.DefaultLifecycleObserver { *; }
-keep class androidx.emoji2.text.** { *; }

# Keep Kotlin reflect and text internal classes intact
-keep class kotlin.text.** { *; }
-keepclassmembers class kotlin.text.** { *; }